{
  "name": "dnd-tracker-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for D&D Initiative Tracker",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "openai": "^4.20.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "private": true
}
